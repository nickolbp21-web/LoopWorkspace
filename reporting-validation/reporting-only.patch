+    public func uploadBasalReportingSnapshot(_ doses: [DoseEntry], completion: @escaping (Result<Bool, Error>) -> Void) {
+        guard hasConfiguration, let uploader = uploader else {
+            completion(.success(false)); return
+        }
+        let wanted = doses.compactMap { $0.basalSnapshotTreatment(enteredBy: "loop://reporting-snapshot") }
+        guard !wanted.isEmpty, let first = wanted.map({ $0.timestamp }).min(),
+              let last = wanted.map({ $0.timestamp }).max() else {
+            completion(.success(false)); return
+        }
+        guard Set(wanted.compactMap { $0.syncIdentifier }).count == wanted.count else {
+            completion(.failure(NightscoutServiceError.uploadedObjectCountMismatch)); return
+        }
+        let interval = DateInterval(start: first.addingTimeInterval(-1), end: last.addingTimeInterval(1))
+        func reconcile(_ actual: [NightscoutTreatment]) throws -> [NightscoutTreatment] {
+            guard actual.count < 5000 else { throw NightscoutServiceError.uploadedObjectCountMismatch }
+            var missing = [NightscoutTreatment]()
+            for item in wanted {
+                let matches = actual.filter { $0.syncIdentifier == item.syncIdentifier }
+                guard matches.count <= 1 else { throw NightscoutServiceError.uploadedObjectCountMismatch }
+                if let match = matches.first {
+                    guard match.eventType == .note, match.notes == item.notes else {
+                        throw NightscoutServiceError.uploadedObjectCountMismatch
+                    }
+                } else { missing.append(item) }
+            }
+            return missing
+        }
+        func cacheVerifiedSnapshot(_ actual: [NightscoutTreatment]) throws {
+            for item in wanted {
+                guard let identifier = item.syncIdentifier,
+                      let objectId = actual.first(where: { $0.syncIdentifier == identifier })?.id,
+                      !objectId.isEmpty else { throw NightscoutServiceError.uploadedObjectCountMismatch }
+                self.objectIdCache.add(syncIdentifier: identifier, objectId: objectId)
+            }
+            self.stateDelegate?.pluginDidUpdateState(self)
+        }
+        uploader.fetchTreatments(dateInterval: interval, maxCount: 5000) { result in
+            switch result {
+            case .failure(let error): completion(.failure(error))
+            case .success(let actual):
+                do {
+                    let missing = try reconcile(actual)
+                    if missing.isEmpty { try cacheVerifiedSnapshot(actual); completion(.success(true)); return }
+                    uploader.upload(missing) { result in
+                        switch result {
+                        case .failure(let error): completion(.failure(error))
+                        case .success:
+                            uploader.fetchTreatments(dateInterval: interval, maxCount: 5000) { result in
+                                switch result {
+                                case .failure(let error): completion(.failure(error))
+                                case .success(let verified):
+                                    do {
+                                        guard try reconcile(verified).isEmpty else {
+                                            throw NightscoutServiceError.uploadedObjectCountMismatch
+                                        }
+                                        try cacheVerifiedSnapshot(verified)
+                                        completion(.success(true))
+                                    } catch { completion(.failure(error)) }
+                                }
+                            }
+                        }
+                    }
+                } catch { completion(.failure(error)) }
+            }
+        }
+    }
