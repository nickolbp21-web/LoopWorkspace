+    // Reporting metadata only. Original treatment amount/rate/duration stay unchanged.
+    private func preciseBasalReport() -> String? {
+        guard !isMutable, endDate >= startDate,
+              let identifier = syncIdentifier, !identifier.isEmpty,
+              deliveredUnits != nil || (type == .suspend && unit == .units && unitsInDeliverableIncrements == 0)
+        else { return nil }
+        let payload: [String: Any] = [
+            "schema": "loop-basal-report-v1",
+            "startUnixSeconds": startDate.timeIntervalSince1970,
+            "endUnixSeconds": endDate.timeIntervalSince1970,
+            "units": unitsInDeliverableIncrements,
+            "basis": deliveredUnits != nil ? "reportedDeliveredUnits" : "recordedUnits",
+            "immutable": true
+        ]
+        guard JSONSerialization.isValidJSONObject(payload),
+              let data = try? JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys])
+        else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+
+    func basalSnapshotTreatment(enteredBy source: String) -> NightscoutTreatment? {
+        guard !isMutable, endDate >= startDate, endDate <= Date(),
+              let identifier = syncIdentifier, !identifier.isEmpty else { return nil }
+        let basis: String
+        switch type {
+        case .basal:
+            basis = deliveredUnits != nil ? "reportedDeliveredUnits" :
+                (identifier.hasPrefix("BasalRateSchedule ") ? "scheduleDerived" : "recordedUnits")
+        case .tempBasal:
+            guard deliveredUnits != nil else { return nil }
+            basis = "reportedDeliveredUnits"
+        case .suspend:
+            guard unit == .units, unitsInDeliverableIncrements == 0 else { return nil }
+            basis = "recordedUnits"
+        default:
+            return nil
+        }
+        let payload: [String: Any] = [
+            "schema": "loop-basal-report-v1", "immutable": true,
+            "sourceDoseIdentifier": identifier,
+            "startUnixSeconds": startDate.timeIntervalSince1970,
+            "endUnixSeconds": endDate.timeIntervalSince1970,
+            "units": unitsInDeliverableIncrements, "basis": basis
+        ]
+        guard JSONSerialization.isValidJSONObject(payload),
+              let data = try? JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys]),
+              let notes = String(data: data, encoding: .utf8) else { return nil }
+        return NightscoutTreatment(timestamp: startDate, enteredBy: source, notes: notes,
+            eventType: .note, syncIdentifier: "loop-basal-snapshot-v1:" + identifier,
+            insulinType: insulinType?.brandName)
+    }
+
 }
